# Gemini Prediction Markets — leave blank to simulate hedge orders (market data is public, no key needed)
GEMINI_API_KEY=
GEMINI_API_SECRET=
# GEMINI_API_BASE=https://api.sandbox.gemini.com
# GEMINI_OFFLINE=1   # force the committed market snapshot

# Arc testnet — leave blank to simulate on-chain policy/settlement txs
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_OPERATOR_KEY=
# ARC_VAULT_ADDRESS=  # defaults to src/lib/arc/deployment.json (written by contracts/ deploy)
