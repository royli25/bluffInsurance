# Gemini Prediction Markets — leave blank to simulate hedge orders (market data is public, no key needed)
GEMINI_API_KEY=
GEMINI_API_SECRET=
# GEMINI_API_BASE=https://api.sandbox.gemini.com
# GEMINI_OFFLINE=1   # force the committed market snapshot

# Arc testnet — leave blank to simulate on-chain policy/settlement txs
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_OPERATOR_KEY=
# ARC_VAULT_ADDRESS=  # defaults to src/lib/arc/deployment.json (written by contracts/ deploy)

# QuickNode Streams — Arc execution confirmation; see ../docs/QUICKNODE-STREAMS.md
# Run npm run streams:init to generate a private webhook security token locally.
QUICKNODE_STREAMS_ENABLED=0
QUICKNODE_STREAM_SECURITY_TOKEN=
QUICKNODE_STREAM_ID=
# Expected provider network identifier; must match the configured Arc testnet Stream.
QUICKNODE_STREAM_NETWORK=arc-testnet
# Explicitly approved finite historical Stream IDs, comma separated.
QUICKNODE_BACKFILL_STREAM_IDS=
# Management CLI only; these are not needed by the running webhook server.
QUICKNODE_API_KEY=
QUICKNODE_WEBHOOK_URL=

# Persistent local disk, Node >=22. Defaults to web/data/runtime/bluff.sqlite.
# BLUFF_DB_PATH=/absolute/persistent/path/bluff.sqlite
# BLUFF_LEGACY_DB_PATH=/absolute/path/to/old/db.json
